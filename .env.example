# RideRakshak Environment Configuration Example
# Copy this to .env and fill in your values

# Backend
DATABASE_URL=sqlite:///./riderakshak.db
# For PostgreSQL (future): DATABASE_URL=postgresql://user:password@localhost:5432/riderakshak

# App Settings
APP_ENV=development
LOG_LEVEL=INFO

# Simulation Settings
SIMULATION_MODE=true
DEFAULT_RIDER_ID=RR001

# False Alert Cancellation Window (seconds)
CANCELLATION_WINDOW_SECONDS=10

# GPS Simulation (Pune, Maharashtra, India - Default)
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API URL
VITE_API_URL=http://localhost:8000
